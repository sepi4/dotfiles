
(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-GXT_865_Gaming_keyboard_GXT_865_Gaming_keyboard-event-kbd")
  output (uinput-sink "My KMonad output"
    ;; To understand the importance of the following line, see the section on
    ;; Compose-key sequences at the near-bottom of this file.
    "sleep 1 && setxkbmap -option compose:ralt")
  cmp-seq ralt    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press
  key-seq-delay 5 ;; 5ms delay between each outputted key event

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true

  ;; Set the implicit around to `around`
  implicit-around around
)


(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ins home pgup nlck kp/ kp* kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    del
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)

(deflayer coh0
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _   @untog
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc _   _   _   _    _    @on @off
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    @dt-del
  caps a    s    d    f    g    h    j    k    l    ;    '    @runtog
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           kp0            ralt rmet cmp  rctl
)

(deflayer cohS
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _   @tog
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc _   _   _   _    _    @on @off
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    @dt-del    
  caps a    s    d    f    g    h    j    k    l    ;    '    @rtog
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _   _
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc _   _   _   _    _    @on @off
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    _
  caps a    s    d    f    g    h    j    k    l    ;    '    _
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)


(defalias
  rtog (tap-macro ret (layer-switch coh0))
  runtog (tap-macro ret (layer-switch cohS))

  tog (layer-switch coh0)
  untog (layer-switch cohS)

  on (layer-switch coh0)
  off (layer-switch base)

  my-seq (tap-macro ret g g ret (pause 100) ret / l (pause 100) ret)
  ;; Double tap logic:
  ;; If tapped once: send Delete
  ;; If tapped twice within 300ms: run the macro
  dt-del (multi-tap 300 del @my-seq)

)


